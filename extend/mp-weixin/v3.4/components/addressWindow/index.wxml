<view style="{{(viewColor)}}" class="data-v-3a28b8f3"><view class="{{['address-window','popup-main','bg-f','data-v-3a28b8f3',address.address==true?'on':'']}}"><view class="title font-500 data-v-3a28b8f3">选择地址<text data-event-opts="{{[['tap',[['close',['$event']]]]]}}" class="iconfont icon-ic_close popup-close data-v-3a28b8f3" bindtap="__e"></text></view><scroll-view class="list data-v-3a28b8f3" scroll-y="true"><block wx:for="{{addressList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['tapAddress',[index,'$0'],[[['addressList','',index,'address_id']]]]]]]}}" class="{{['item','acea-row','row-between-wrapper','data-v-3a28b8f3',active==index?'t-color':'']}}" bindtap="__e"><text class="{{['iconfont','icon-ic_location5','data-v-3a28b8f3',active==index?'t-color':'']}}"></text><view class="address data-v-3a28b8f3"><view class="{{['name','font-bold','data-v-3a28b8f3',active==index?'t-color':'']}}">{{item.real_name}}<text class="phone data-v-3a28b8f3">{{item.phone}}</text></view><view class="line1 data-v-3a28b8f3">{{item.province+item.city+item.district+(item.street||'')+item.detail+''}}</view></view><text class="{{['iconfont','icon-complete','data-v-3a28b8f3',active==index?'t-color':'']}}"></text></view></block></scroll-view><block wx:if="{{$root.g0}}"><view class="pictrue data-v-3a28b8f3"><image src="{{domain+'/static/images/noAddress.png'}}" class="data-v-3a28b8f3"></image><view class="data-v-3a28b8f3">暂无地址</view></view></block><view data-event-opts="{{[['tap',[['goAddressPages',['$event']]]]]}}" class="addressBnt data-v-3a28b8f3" bindtap="__e">添加新地址</view></view><view class="mask data-v-3a28b8f3" catchtouchmove="true" hidden="{{address.address==false}}" data-event-opts="{{[['tap',[['close',['$event']]]]]}}" bindtap="__e"></view></view>